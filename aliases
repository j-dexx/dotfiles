alias artisan="php artisan"

alias nah="git reset --hard && git clean -df"
if [ -f "/usr/bin/php56" ]; then
  alias php5="/usr/bin/php56"
fi

if command_exists kubectl; then
  alias k=kubectl
  # switch namespace with kcd namespace
  alias kcd='kubectl config set-context $(kubectl config current-context) --namespace '
fi

alias awsume-dev="awsume jpd-connect -o jpd-connect --role-arn arn:aws:iam::497273648105:role/OrganizationAccountAccessRole --source-profile jpd"
